# Godly Base — local cloud environment. Copy to .env and fill in.
# NOTHING in this file belongs in git, the database, or the codex UI.

# --- core ------------------------------------------------------------------
DATABASE_URL=postgresql://godly:CHANGE_ME@localhost:5432/godly
OBSIDIAN_VAULT_PATH=/srv/brain
LOCAL_OBJECT_STORE=/srv/vault/raw

# --- reasoning -------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- sales intelligence ----------------------------------------------------
APOLLO_API_KEY=
HUNTER_API_KEY=            # free tier = 50 credits/mo; verify = 0.5 credit
CLAY_API_KEY=

# --- research / crawling ---------------------------------------------------
FIRECRAWL_API_KEY=
CRAWL4AI_BASE_URL=http://localhost:11235

# --- CRM -------------------------------------------------------------------
TWENTY_API_KEY=
TWENTY_BASE_URL=http://localhost:3000
HUBSPOT_PRIVATE_APP_TOKEN=

# --- outreach --------------------------------------------------------------
INSTANTLY_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
UNIPILE_API_KEY=           # compliant LinkedIn access; no browser automation
UNIPILE_ACCOUNT_ID=

# --- publishing ------------------------------------------------------------
POSTIZ_API_KEY=
POSTIZ_BASE_URL=http://localhost:5000
LISTMONK_URL=http://localhost:9000
LISTMONK_USER=
LISTMONK_PASS=

# --- google ----------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GDRIVE_ROOT_FOLDER_ID=

# --- guardrails ------------------------------------------------------------
CREDIT_WARN_THRESHOLD=0.90     # credit warden pauses the consuming agent here
DAILY_SPEND_CEILING_USD=50
SEND_DOMAIN_BOUNCE_CEILING=0.03
